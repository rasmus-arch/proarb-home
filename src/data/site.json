  "usp": [
    {
      "title": "Eget tryckeri & broderi",
      "text": "In-house tryck, brodyr och reflex – full kontroll på kvalitet och leveranstider, utan mellanhänder."
    },
    {
      "title": "Rätt klassning, varje gång",
      "text": "Varselplagg enligt EN ISO 20471 och skyddsskor enligt S1–S7. Vi ser till att ni är certifierade på riktigt."
    },
    {
      "title": "Personlig rådgivning",
      "text": "Ingen kundtjänstkö. Ni når oss direkt på telefon och får svar samma dag."
    },
    {
      "title": "Hela sortimentet",
      "text": "Sajten visar ett urval. Behöver ni något annat tar vi fram det ur leverantörernas kataloger."
    }
  ],
  "steps": [
    {
      "title": "Berätta om behovet",
      "text": "Antal personer, yrken, säsong och budget. Ett samtal eller ett formulär räcker."
    },
    {
      "title": "Ni får ett förslag",
      "text": "Vi väljer ut plagg, tar fram pris och visar hur er logotyp sitter på plagget."
    },
    {
      "title": "Korrektur & produktion",
      "text": "Ni godkänner ett digitalt korrektur innan vi trycker eller broderar något."
    },
    {
      "title": "Leverans & påfyllning",
      "text": "Vi levererar och sparar er profil, så nästa beställning tar fem minuter."
