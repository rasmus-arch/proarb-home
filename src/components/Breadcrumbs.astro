---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="bc" aria-label="Brödsmulor">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
        {i < items.length - 1 && (
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        )}
      </li>
    ))}
  </ol>
</nav>
<style>
  .bc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem; }
  .bc li { display: flex; align-items: center; gap: .3rem; font-size: .84rem; color: var(--ink-3); }
  .bc a { text-decoration: none; }
  .bc a:hover { color: var(--ink); }
  .bc span { color: var(--ink-2); }
</style>
