---
interface Props { class?: string; compact?: boolean }
const { class: className, compact = false } = Astro.props;
---
<span class={`logo ${compact ? 'logo--compact' : ''} ${className ?? ''}`}>
  <svg class="logo__mark" viewBox="0 0 200 200" role="img" aria-label="Proarb – Profil &amp; Arbetskläder">
    <defs>
      <clipPath id="proarb-badge-clip"><circle cx="100" cy="100" r="94" /></clipPath>
    </defs>
    <circle cx="100" cy="100" r="94" fill="#0e3a41" />
    <g clip-path="url(#proarb-badge-clip)">
      <rect x="0" y="66" width="200" height="68" fill="#f5b73c" />
    </g>
    <circle cx="100" cy="100" r="94" fill="none" stroke="#0a2a30" stroke-width="7" />
    <text x="100" y="95" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="27" fill="#0e3a41" letter-spacing="0.5">PROFIL &amp;</text>
    <text x="100" y="119" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-weight="700" font-size="19" fill="#0e3a41" letter-spacing="1.5">ARBETSKLÄDER</text>
  </svg>
</span>

<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; color: var(--ink); }
  .logo__mark { width: 2.6rem; height: 2.6rem; flex: none; }
  .logo--compact .logo__mark { width: 2.2rem; height: 2.2rem; }
</style>
