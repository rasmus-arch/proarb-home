---
import { site } from '../lib/content';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<a class="skip" href="#main">Hoppa till innehållet</a>

<header class="hdr" id="hdr">
  <div class="container hdr__in">
    <a href="/" class="hdr__logo" aria-label="Profil & Arbetskläder – till startsidan"><img class="wordmark" src="/images/logo-lang.svg" alt="Profil & Arbetskläder" width="693" height="100" /></a>

    <nav class="nav" aria-label="Huvudmeny">
      <ul class="nav__list">
        {site.nav.map((item: any) => (
          <li class={item.children ? 'nav__item nav__item--has-menu' : 'nav__item'}>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="mega">
                <ul class="mega__list">
                  {item.children.map((c: any) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
                <a class="mega__all link-arrow" href={item.href}>
                  Hela {item.label.toLowerCase()}
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--accent hdr__cta" href="/kontakt/">Begär offert</a>
      <button class="menubtn" type="button" data-menu-open aria-expanded="false" aria-controls="drawer">
        <svg width="19" height="19" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span>Meny</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobilmeny -->
<div class="drawer" id="drawer" hidden>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Meny">
    <div class="drawer__top">
      <img class="wordmark wordmark--sm" src="/images/logo-lang.svg" alt="Profil & Arbetskläder" width="693" height="100" />
      <button class="iconbtn" type="button" data-menu-close aria-label="Stäng meny">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="drawer__nav" aria-label="Meny">
      {site.nav.map((item: any) => (
        <div class="drawer__group">
          <a class="drawer__head" href={item.href}>{item.label}</a>
          {item.children && (
            <ul>{item.children.map((c: any) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
          )}
        </div>
      ))}
    </nav>
    <div class="drawer__foot">
      <a class="btn btn--accent" href="/kontakt/">Begär offert</a>
      <a class="btn btn--ghost" href={site.phoneHref}>Ring {site.phone}</a>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg);
    border-bottom: var(--rule);
  }
  .hdr__in { display: flex; align-items: center; gap: 2rem; min-height: 4.75rem; }
  .hdr__logo { text-decoration: none; margin-right: auto; display: block; flex: 0 1 auto; min-width: 0; }
  .wordmark { display: block; height: 2.5rem; width: auto; max-width: 100%; object-fit: contain; object-position: left center; }
  .wordmark--sm { height: 1.9rem; }

  .nav { align-self: stretch; display: flex; }
  .nav__list { display: flex; gap: 1.6rem; list-style: none; padding: 0; margin: 0; }
  .nav__item { position: relative; display: flex; align-items: center; }
  .nav__link {
    display: inline-flex; align-items: center; gap: .35rem;
    padding-block: .4rem; border-bottom: 2px solid transparent;
    font-family: var(--font-display); font-weight: 700; font-size: 1.25rem;
    text-transform: uppercase; letter-spacing: .02em; line-height: 1.1; white-space: nowrap;
    text-decoration: none; color: var(--ink);
  }
  .nav__link svg { flex: none; }
  .nav__link:hover, .nav__item:focus-within .nav__link { border-bottom-color: var(--ink); }
  .nav__link[aria-current='page'] { border-bottom-color: var(--amber); }

  .mega {
    position: absolute; top: 100%; left: -1.1rem; min-width: 17rem;
    background: var(--bg); border: var(--rule);
    padding: .5rem 0 .9rem;
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .14s, transform .14s, visibility .14s;
  }
  .nav__item--has-menu:hover .mega, .nav__item--has-menu:focus-within .mega {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .mega__list { list-style: none; margin: 0; padding: 0; }
  .mega__list a {
    display: block; padding: .5rem 1.1rem;
    text-decoration: none; font-size: .95rem; color: var(--ink);
  }
  .mega__list a:hover { background: var(--amber); }
  .mega__all { margin: .6rem 1.1rem 0; font-size: .9rem; }

  .hdr__actions { display: flex; align-items: center; gap: .6rem; align-self: stretch; }
  .hdr__cta, .menubtn { align-self: center; }
  .hdr__cta { margin-left: .8rem; padding: .85rem 1.5rem .8rem; font-size: 1.2rem; }

  .iconbtn {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem;
    background: transparent; border: var(--rule); border-radius: var(--r);
    cursor: pointer; color: var(--ink);
  }
  .iconbtn:hover { background: var(--ink); color: var(--paper); }

  .menubtn {
    display: none; align-items: center; gap: .45rem;
    background: var(--ink); color: var(--paper); border: 1.5px solid var(--ink);
    border-radius: var(--r); padding: .6rem .9rem .55rem .8rem;
    font-family: var(--font-display); font-weight: 700; font-size: 1rem;
    text-transform: uppercase; letter-spacing: .03em; line-height: 1;
    cursor: pointer; flex: none;
  }
  .menubtn:hover { background: var(--petrol); border-color: var(--petrol); }

  @media (max-width: 1240px) {
    .nav { display: none; }
    .menubtn { display: inline-flex; }
    .hdr__cta { margin-left: 0; padding: .7rem 1rem .65rem; font-size: 1.05rem; }
    .hdr__in { gap: 1rem; }
    .wordmark { height: auto; width: 15.5rem; }
  }
  @media (max-width: 480px) {
    .hdr__in { gap: .5rem; min-height: 4.2rem; }
    .hdr__logo { flex: 1 1 0; }
    .wordmark { width: 100%; max-width: 15.5rem; }
    .hdr__actions { gap: .4rem; }
    .hdr__cta { padding-inline: .65rem; font-size: .92rem; }
    .menubtn { padding-inline: .6rem; font-size: .92rem; }
  }

  .drawer { position: fixed; inset: 0; z-index: 100; background: rgba(15, 44, 51, .5); }
  .drawer[hidden] { display: none; }
  .drawer__panel {
    position: absolute; inset: 0 0 0 auto; width: min(24rem, 100vw);
    background: var(--bg); border-left: var(--rule); display: flex; flex-direction: column;
    padding: 1.1rem var(--gutter) 1.5rem; overflow-y: auto;
    animation: slide .2s cubic-bezier(.2,.8,.3,1);
  }
  @keyframes slide { from { transform: translateX(10%); opacity: .6 } }
  .drawer__top {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 1rem; margin-bottom: 1.2rem; border-bottom: var(--rule);
  }
  .drawer__nav { flex: 1; }
  .drawer__group + .drawer__group { margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .drawer__head {
    font-family: var(--font-display); font-weight: 800; font-size: 1.9rem; line-height: 1;
    text-transform: uppercase; text-decoration: none; display: block;
  }
  .drawer__nav ul { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
  .drawer__nav ul a {
    display: block; padding: .4rem 0; color: var(--ink-2); text-decoration: none; font-size: .97rem;
  }
  .drawer__nav ul a:hover { color: var(--ink); text-decoration: underline; }
  .drawer__foot { display: grid; gap: .6rem; margin-top: 2rem; }
</style>

<script>
  const drawer = document.getElementById('drawer');
  const openBtn = document.querySelector('[data-menu-open]');
  const closeBtn = document.querySelector('[data-menu-close]');
  const toggle = (open: boolean) => {
    if (!drawer) return;
    drawer.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) drawer.querySelector<HTMLElement>('a, button')?.focus();
    else (openBtn as HTMLElement | null)?.focus();
  };
  openBtn?.addEventListener('click', () => toggle(true));
  closeBtn?.addEventListener('click', () => toggle(false));
  drawer?.addEventListener('click', (e) => { if (e.target === drawer) toggle(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) toggle(false); });
</script>
