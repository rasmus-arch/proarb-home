---
import Logo from './Logo.astro';
import { site } from '../lib/content';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<a class="skip" href="#main">Hoppa till innehållet</a>

<div class="topbar">
  <div class="container topbar__in">
    <span class="topbar__item">Arbets- &amp; profilkläder till företag och föreningar · Eskilstuna</span>
    <span class="topbar__links">
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  </div>
</div>

<header class="hdr" id="hdr">
  <div class="container hdr__in">
    <a href="/" class="hdr__logo" aria-label="Proarb – till startsidan"><Logo /></a>

    <nav class="nav" aria-label="Huvudmeny">
      <ul class="nav__list">
        {site.nav.map((item: any) => (
          <li class={item.children ? 'nav__item nav__item--has-menu' : 'nav__item'}>
            <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="mega">
                <ul class="mega__list">
                  {item.children.map((c: any) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
                <a class="mega__all link-arrow" href={item.href}>
                  Hela {item.label.toLowerCase()}
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--sm hdr__cta" href="/kontakt/">Begär offert</a>
      <button class="iconbtn iconbtn--menu" type="button" data-menu-open aria-label="Öppna meny" aria-expanded="false" aria-controls="drawer">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobilmeny -->
<div class="drawer" id="drawer" hidden>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Meny">
    <div class="drawer__top">
      <Logo compact />
      <button class="iconbtn" type="button" data-menu-close aria-label="Stäng meny">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="drawer__nav" aria-label="Meny">
      {site.nav.map((item: any) => (
        <div class="drawer__group">
          <a class="drawer__head" href={item.href}>{item.label}</a>
          {item.children && (
            <ul>{item.children.map((c: any) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
          )}
        </div>
      ))}
    </nav>
    <div class="drawer__foot">
      <a class="btn" href="/kontakt/">Begär offert</a>
      <a class="btn btn--ghost" href={site.phoneHref}>Ring {site.phone}</a>
    </div>
  </div>
</div>

<style>
  .topbar {
    background: var(--bg-sunk); color: var(--ink-2); border-bottom: 1px solid var(--line);
    font-size: .78rem; letter-spacing: .01em;
  }
  .topbar__in { display: flex; justify-content: space-between; gap: 1rem; padding-block: .5rem; }
  .topbar__item { color: var(--ink-3); }
  .topbar__links { display: flex; gap: 1.25rem; }
  .topbar__links a { text-decoration: none; color: var(--ink); font-weight: 500; }
  .topbar__links a:hover { color: var(--accent-ink); }
  @media (max-width: 720px) { .topbar__item { display: none; } .topbar__in { justify-content: center; } }

  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; min-height: 4.4rem; }
  .hdr__logo { text-decoration: none; margin-right: auto; }

  .nav__list { display: flex; gap: .35rem; list-style: none; padding: 0; margin: 0; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .55rem .8rem; border-radius: var(--r-pill);
    font-family: var(--font-display); font-weight: 560; font-size: .95rem;
    text-decoration: none; color: var(--ink-2);
  }
  .nav__link:hover, .nav__item:focus-within .nav__link { color: var(--ink); background: var(--bg-sunk); }
  .nav__link[aria-current='page'] { color: var(--ink); }

  .mega {
    position: absolute; top: calc(100% + .5rem); left: 0; min-width: 16rem;
    background: var(--bg-raised); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-2); padding: .6rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .16s, transform .16s, visibility .16s;
  }
  .nav__item--has-menu:hover .mega, .nav__item--has-menu:focus-within .mega {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .mega__list { list-style: none; margin: 0; padding: 0; }
  .mega__list a {
    display: block; padding: .5rem .7rem; border-radius: var(--r-sm);
    text-decoration: none; font-size: .95rem; color: var(--ink-2);
  }
  .mega__list a:hover { background: var(--bg-sunk); color: var(--ink); }
  .mega__all { margin: .4rem .7rem .3rem; font-size: .9rem; color: var(--accent-ink); }

  .hdr__actions { display: flex; align-items: center; gap: .5rem; }
  .iconbtn {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem;
    background: transparent; border: 1px solid var(--line); border-radius: var(--r-pill);
    cursor: pointer; color: var(--ink-2); transition: border-color .15s, color .15s;
  }
  .iconbtn:hover { border-color: var(--ink); color: var(--ink); }
  .iconbtn--menu { display: none; }

  @media (max-width: 1040px) {
    .nav { display: none; }
    .iconbtn--menu { display: grid; }
    .hdr__cta { display: none; }
  }

  .drawer { position: fixed; inset: 0; z-index: 100; background: rgba(10,12,14,.45); }
  .drawer[hidden] { display: none; }
  .drawer__panel {
    position: absolute; inset: 0 0 0 auto; width: min(22rem, 92vw);
    background: var(--bg); display: flex; flex-direction: column;
    padding: 1.1rem var(--gutter) 1.5rem; overflow-y: auto;
    animation: slide .22s cubic-bezier(.2,.8,.3,1);
  }
  @keyframes slide { from { transform: translateX(12%); opacity: .6 } }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .drawer__nav { flex: 1; }
  .drawer__group + .drawer__group { margin-top: 1.4rem; }
  .drawer__head {
    font-family: var(--font-display); font-weight: 650; font-size: 1.1rem;
    text-decoration: none; display: block; margin-bottom: .4rem;
  }
  .drawer__nav ul { list-style: none; margin: 0; padding: 0 0 0 .1rem; }
  .drawer__nav ul a {
    display: block; padding: .42rem 0; color: var(--ink-2); text-decoration: none; font-size: .97rem;
  }
  .drawer__nav ul a:hover { color: var(--ink); }
  .drawer__foot { display: grid; gap: .6rem; margin-top: 2rem; }
</style>

<script>
  const drawer = document.getElementById('drawer');
  const openBtn = document.querySelector('[data-menu-open]');
  const closeBtn = document.querySelector('[data-menu-close]');
  const toggle = (open: boolean) => {
    if (!drawer) return;
    drawer.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) drawer.querySelector<HTMLElement>('a, button')?.focus();
    else (openBtn as HTMLElement | null)?.focus();
  };
  openBtn?.addEventListener('click', () => toggle(true));
  closeBtn?.addEventListener('click', () => toggle(false));
  drawer?.addEventListener('click', (e) => { if (e.target === drawer) toggle(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) toggle(false); });
</script>
