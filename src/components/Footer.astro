---
import Logo from './Logo.astro';
import { site, categories } from '../lib/content';
const work = categories.filter((c) => c.group === 'arbete' && c.url !== 'arbetsklader');
const profile = categories.filter((c) => c.group === 'profil' && c.url !== 'profilprodukter');
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <Logo />
        <p class="ftr__pitch">
          Den personliga butiken för profil- och arbetskläder. Vi hjälper företag och
          föreningar i Eskilstuna med mälardalen att se bra ut och jobba säkert.
        </p>
        <div class="ftr__contact">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>{site.address.street}, {site.address.postalCode} {site.address.city}</span>
        </div>
      </div>

      <nav class="ftr__col" aria-label="Arbetskläder">
        <h2>Arbetskläder</h2>
        <ul>{work.map((c) => <li><a href={`/${c.url}/`}>{c.name}</a></li>)}</ul>
      </nav>

      <nav class="ftr__col" aria-label="Profilprodukter">
        <h2>Profilprodukter</h2>
        <ul>{profile.map((c) => <li><a href={`/${c.url}/`}>{c.name}</a></li>)}</ul>
      </nav>

      <nav class="ftr__col" aria-label="Företaget">
        <h2>Företaget</h2>
        <ul>
          <li><a href="/om-oss/">Om oss</a></li>
          <li><a href="/kontakt/">Kontakt &amp; offert</a></li>
          <li><a href="/tryck-och-brodyr/">Tryck &amp; brodyr</a></li>
          <li><a href="/kopvillkor/">Köpvillkor</a></li>
          <li><a href="/integritetspolicy/">Integritetspolicy</a></li>
        </ul>
      </nav>
    </div>

    <div class="ftr__bottom">
      <p>© {year} {site.legalName}. Alla priser exkl. moms.</p>
      <div class="ftr__social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Proarb på Facebook">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8.2h2.75l.41-3.2H13.5V7.6c0-.93.26-1.56 1.59-1.56h1.7V3.18C16.5 3.12 15.53 3 14.4 3c-2.36 0-3.97 1.44-3.97 4.08v2.52H7.67v3.2h2.76V21h3.07Z"/></svg>
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Proarb på Instagram">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2c2.72 0 3.05.01 4.12.06 1.07.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.16.55.55.9 1.11 1.16 1.77.25.64.42 1.36.47 2.43.05 1.07.06 1.4.06 4.12s-.01 3.05-.06 4.12c-.05 1.07-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.16 1.77 4.9 4.9 0 0 1-1.77 1.16c-.64.25-1.36.42-2.43.47-1.07.05-1.4.06-4.12.06s-3.05-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.25-.64-.42-1.36-.47-2.43C2.01 15.05 2 14.72 2 12s.01-3.05.06-4.12c.05-1.07.22-1.79.47-2.43.26-.66.6-1.22 1.16-1.77A4.9 4.9 0 0 1 5.46 2.53c.64-.25 1.36-.42 2.43-.47C8.95 2.01 9.28 2 12 2Zm0 1.8c-2.67 0-2.99.01-4.04.06-.87.04-1.34.18-1.66.3-.42.16-.72.36-1.03.67-.31.31-.5.6-.67 1.03-.12.32-.26.79-.3 1.66C4.24 8.56 4.23 8.88 4.23 12s.01 3.44.06 4.49c.04.87.18 1.34.3 1.66.16.42.36.72.67 1.03.31.31.6.5 1.03.67.32.12.79.26 1.66.3 1.05.05 1.37.06 4.05.06s2.99-.01 4.04-.06c.87-.04 1.34-.18 1.66-.3.42-.16.72-.36 1.03-.67.31-.31.5-.6.67-1.03.12-.32.26-.79.3-1.66.05-1.05.06-1.37.06-4.49s-.01-3.44-.06-4.49c-.04-.87-.18-1.34-.3-1.66a2.75 2.75 0 0 0-.67-1.03 2.75 2.75 0 0 0-1.03-.67c-.32-.12-.79-.26-1.66-.3-1.05-.05-1.37-.06-4.04-.06Zm0 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 1.8a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm4.68-2a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z"/></svg>
        </a>
        <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="Proarb på TikTok">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 2h-3.2v13.9c0 1.5-1.2 2.7-2.7 2.7s-2.7-1.2-2.7-2.7 1.2-2.7 2.7-2.7c.3 0 .6.05.85.13V9.9c-.28-.04-.56-.06-.85-.06-3.2 0-5.8 2.6-5.8 5.8S8.35 21.4 11.55 21.4s5.8-2.6 5.8-5.8V8.4c1.15.9 2.6 1.44 4.15 1.44V6.6c-.9 0-1.75-.28-2.45-.76A5.02 5.02 0 0 1 16.6 2Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--bg-sunk); border-top: 1px solid var(--line); padding-block: clamp(3rem, 2rem + 3vw, 4.5rem) 2rem; margin-top: auto; }
  .ftr__grid { display: grid; gap: 2.5rem; grid-template-columns: 1.4fr repeat(3, 1fr); }
  @media (max-width: 900px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ftr__grid { grid-template-columns: 1fr; } }
  .ftr__pitch { margin-top: 1rem; color: var(--ink-2); max-width: 34ch; font-size: .95rem; }
  .ftr__contact { display: grid; gap: .3rem; margin-top: 1.2rem; font-size: .95rem; }
  .ftr__contact a { text-decoration: none; font-weight: 550; }
  .ftr__contact a:hover { color: var(--accent-ink); }
  .ftr__contact span { color: var(--ink-3); }
  .ftr__col h2 {
    font-size: .78rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-3); font-weight: 620; margin-bottom: .9rem;
  }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .ftr__col a { text-decoration: none; color: var(--ink-2); font-size: .95rem; }
  .ftr__col a:hover { color: var(--ink); }
  .ftr__bottom {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--line);
    font-size: .82rem; color: var(--ink-3);
  }
  .ftr__social { display: flex; gap: .6rem; }
  .ftr__social a {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem;
    border: 1px solid var(--line-strong); border-radius: var(--r-pill);
    color: var(--ink-2); transition: color .15s, border-color .15s;
  }
  .ftr__social a:hover { color: var(--ink); border-color: var(--ink); }
</style>
