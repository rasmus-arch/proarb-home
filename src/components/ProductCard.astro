---
import ProductImage from './ProductImage.astro';
import type { Product } from '../lib/content';
interface Props { product: Product; eager?: boolean }
const { product: p, eager = false } = Astro.props;
const colors = p.variants.map((v) => v.color).filter(Boolean) as string[];
---
<article class="card">
  <a class="card__link" href={`/produkt/${p.slug}/`}>
    <div class="card__media">
      <ProductImage file={p.file} src={p.image} alt={p.name} loading={eager ? 'eager' : 'lazy'} class="card__img" />
    </div>
    <div class="card__body">
      {p.brand && <span class="card__brand">{p.brand}</span>}
      <h3 class="card__title">{p.name}</h3>
      <div class="card__foot">
        {colors.length > 1 ? (
          <span class="card__note">{colors.length} färger</span>
        ) : p.sku ? (
          <span class="card__note">Art.nr {p.sku}</span>
        ) : (
          <span class="card__note">Begär offert</span>
        )}
        <span class="card__arrow" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 14 14"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card { height: 100%; }
  .card__link {
    display: flex; flex-direction: column; height: 100%;
    text-decoration: none; color: inherit;
    border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--bg-raised); overflow: hidden;
    transition: border-color .18s, transform .18s cubic-bezier(.2,.8,.3,1), box-shadow .18s;
  }
  .card__link:hover { border-color: var(--line-strong); transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .card__media { background: var(--bg-sunk); aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; }
  .card__media :global(.card__img) {
    width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply;
    padding: 7%; transition: transform .35s cubic-bezier(.2,.8,.3,1);
  }
  :root[data-theme='dark'] .card__media :global(.card__img) { mix-blend-mode: normal; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .card__media :global(.card__img) { mix-blend-mode: normal; }
  }
  .card__link:hover .card__media :global(.card__img) { transform: scale(1.04); }
  .card__body { padding: .95rem 1rem 1.05rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
  .card__brand { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-ink); font-weight: 620; }
  .card__title {
    font-size: 1rem; font-weight: 600; line-height: 1.3; letter-spacing: -.012em;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card__foot { margin-top: auto; padding-top: .7rem; display: flex; align-items: center; justify-content: space-between; }
  .card__note { font-size: .82rem; color: var(--ink-3); }
  .card__arrow { color: var(--ink-3); transition: transform .2s, color .2s; }
  .card__link:hover .card__arrow { transform: translateX(3px); color: var(--ink); }
</style>
