---
/**
 * Visar en produktbild.
 * Finns bilden lokalt (se src/lib/images.ts) optimeras den av Astro till WebP
 * i flera storlekar. Annars används originalets URL som fallback.
 */
import { Image } from 'astro:assets';
import { localImage } from '../lib/images';

interface Props {
  file?: string | null;
  src?: string | null;
  alt: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  file,
  src,
  alt,
  widths = [300, 600],
  sizes = '(max-width: 640px) 45vw, (max-width: 1100px) 30vw, 300px',
  width = 900,
  height = 900,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className
} = Astro.props;

const entry = localImage(file, src);
// reservbilden i src ska inte vara originalet i full storlek, utan den största i srcset
const fallbackWidth = entry ? Math.min(Math.max(...widths), entry.width) : undefined;
---

{
  entry ? (
    <Image
      src={entry}
      alt={alt}
      width={fallbackWidth}
      widths={widths}
      sizes={sizes}
      quality={72}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  ) : src ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  ) : (
    <div class={`ph ${className ?? ''}`} aria-hidden="true" />
  )
}

<style>
  .ph {
    background: linear-gradient(135deg, var(--bg-sunk), color-mix(in srgb, var(--bg-sunk) 60%, var(--line)));
    aspect-ratio: 1;
    width: 100%;
  }
</style>
