---
---
<dialog class="sd" id="search-dialog" aria-label="Sök i sortimentet">
  <form class="sd__form" method="dialog" role="search" onsubmit="return false">
    <svg class="sd__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M13.6 13.6L18 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    <input id="sd-input" type="search" placeholder="Sök på produkt, varumärke eller artikelnummer…" autocomplete="off" aria-label="Sökord" />
    <kbd>Esc</kbd>
  </form>
  <div class="sd__results" id="sd-results" role="listbox" aria-label="Sökträffar">
    <p class="sd__hint">Skriv för att söka – t.ex. <em>varselbyxa</em>, <em>Blåkläder</em> eller <em>piké</em>.</p>
  </div>
</dialog>

<style>
  .sd {
    width: min(42rem, calc(100vw - 2rem)); padding: 0; border: 1px solid var(--line);
    border-radius: var(--r-lg); background: var(--bg-raised); color: var(--ink);
    box-shadow: 0 30px 70px -30px rgba(0,0,0,.45); margin-top: 8vh;
  }
  .sd::backdrop { background: rgba(8,10,12,.55); backdrop-filter: blur(3px); }
  .sd__form { display: flex; align-items: center; gap: .7rem; padding: 1rem 1.15rem; border-bottom: 1px solid var(--line); }
  .sd__icon { color: var(--ink-3); flex: none; }
  .sd__form input { flex: 1; border: 0; background: transparent; outline: none; font-size: 1.05rem; }
  .sd__form kbd {
    font-family: var(--font-body); font-size: .7rem; color: var(--ink-3);
    border: 1px solid var(--line); border-radius: 5px; padding: .15rem .4rem;
  }
  .sd__results { max-height: min(60vh, 32rem); overflow-y: auto; padding: .5rem; }
  .sd__hint { padding: 1.2rem; color: var(--ink-3); font-size: .95rem; }
  .sd__hint em { font-style: normal; color: var(--ink-2); }
  .sd__item {
    display: flex; gap: .85rem; align-items: center; padding: .55rem .7rem;
    border-radius: var(--r); text-decoration: none; color: inherit;
  }
  .sd__item:hover, .sd__item:focus-visible { background: var(--bg-sunk); }
  .sd__item img { width: 2.6rem; height: 2.6rem; object-fit: contain; background: var(--bg-sunk); border-radius: var(--r-sm); flex: none; }
  .sd__name { font-weight: 550; font-size: .95rem; }
  .sd__meta { font-size: .8rem; color: var(--ink-3); }
</style>

<script>
  type Hit = { s: string; n: string; b: string | null; k: string | null; i: string | null; c: string };
  const dlg = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('sd-input') as HTMLInputElement | null;
  const out = document.getElementById('sd-results');
  let index: Hit[] | null = null;
  let loading = false;

  async function load() {
    if (index || loading) return;
    loading = true;
    try {
      index = await (await fetch('/search.json')).json();
    } catch { index = []; }
    loading = false;
    render(input?.value ?? '');
  }

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function render(q: string) {
    if (!out) return;
    const term = norm(q.trim());
    if (!term) {
      out.innerHTML = '<p class="sd__hint">Skriv för att söka – t.ex. <em>varselbyxa</em>, <em>Blåkläder</em> eller <em>piké</em>.</p>';
      return;
    }
    if (!index) { out.innerHTML = '<p class="sd__hint">Laddar sortiment…</p>'; return; }
    const words = term.split(/\s+/);
    const hits = index
      .map((p) => {
        const hay = norm(`${p.n} ${p.b ?? ''} ${p.k ?? ''} ${p.c}`);
        if (!words.every((w) => hay.includes(w))) return null;
        const score = norm(p.n).startsWith(words[0]) ? 0 : norm(p.n).includes(term) ? 1 : 2;
        return { p, score };
      })
      .filter(Boolean)
      .sort((a, b) => a!.score - b!.score)
      .slice(0, 12) as { p: Hit }[];

    if (!hits.length) {
      out.innerHTML = `<p class="sd__hint">Inga träffar på “${q}”. Ring oss så letar vi i leverantörernas fulla sortiment.</p>`;
      return;
    }
    out.innerHTML = hits
      .map(
        ({ p }) => `<a class="sd__item" href="/produkt/${p.s}/">
          ${p.i ? `<img src="${p.i}" alt="" loading="lazy" width="42" height="42">` : '<span class="sd__item-ph"></span>'}
          <span><span class="sd__name">${p.n}</span><br><span class="sd__meta">${[p.b, p.k].filter(Boolean).join(' · ')}</span></span>
        </a>`
      )
      .join('');
  }

  document.querySelectorAll('[data-search-open]').forEach((b) =>
    b.addEventListener('click', () => { dlg?.showModal(); load(); input?.focus(); })
  );
  input?.addEventListener('input', () => render(input.value));
  document.addEventListener('keydown', (e) => {
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && document.activeElement === document.body)) {
      e.preventDefault();
      dlg?.showModal(); load(); input?.focus();
    }
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
