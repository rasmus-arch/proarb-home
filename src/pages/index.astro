---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site, products, categoryByUrl } from '../lib/content';

const UPLOADS = 'https://proarb.se/wp-content/uploads/2026/04/';
const staging = process.env.STAGING === '1';
const about = (site as any).about ?? {};
const reviews: { text: string; name: string; company?: string; label?: string }[] = about.reviews ?? [];

const withCat = <T extends { url: string }>(items: T[]) =>
  items.map((item) => ({ ...item, cat: categoryByUrl(item.url)! }));

// Arbetskläder – fyra bildkort i asymmetriskt raster
const workFeature = withCat([
  { url: 'arbetsklader', slot: 'c1', title: 'Arbetskläder', image: '/images/kategorier/arbetsklader.jpg',
    text: 'Byxor, jackor och tröjor från Blåkläder, Helly Hansen, Jobman och ProJob.' },
  { url: 'varselklader', slot: 'c2', title: 'Varsel', image: '/images/kategorier/varselklader.webp',
    text: 'Certifierat enligt EN ISO 20471. Vi kollar klassningen åt er.' },
  { url: 'arbetsbyxor', slot: 'c3', title: 'Byxor', image: '/images/kategorier/arbetsbyxor.webp' },
  { url: 'arbetsjackor', slot: 'c4', title: 'Jackor', image: '/images/kategorier/arbetsjackor.webp' }
]);

// …resten som indexrader
const workIndex = withCat([
  { url: 'arbetstrojor', note: 'Fleece, softshell, t-shirts' },
  { url: 'arbetsskor', note: 'Skyddsskor S1P–S7S' },
  { url: 'arbetshandskar', note: 'Touch, skärskydd, vinter' },
  { url: 'arbetsshorts-piratbyxor', note: 'För sommarhalvåret' }
]);

const profileFeature = withCat([
  { url: 'profiltrojor', slot: 'p1', title: 'Profiltröjor', image: UPLOADS + '1110228_HeavyTshirt_2.jpg', pos: 'center top' },
  { url: 'ovriga-profilklader', slot: 'p2', title: 'Profilkläder', image: UPLOADS + 'profilklader-1536x540.webp' },
  { url: 'give-aways', slot: 'p3', title: 'Give aways', image: UPLOADS + 'Skarmbild-2026-04-01-103244.png' }
]);

const profileIndex = withCat([
  { url: 'profiljackor', note: 'Softshell, vinter, regn' },
  { url: 'profilskjortor', note: 'Till kontoret och kassan' }
]);

// Utvalda produkter – tre grupper, styrs från site.json (featured)
const featuredGroups = ((site as any).featured ?? []).map((g: any) => ({
  ...g,
  items: g.items.map((it: any) => {
    const product = it.slug ? products.find((x) => x.slug === it.slug) : undefined;
    return { ...it, product, href: product ? `/produkt/${product.slug}/` : '/kontakt/' };
  })
}));

// Varumärken: utvalda med logga, resten som text
const featuredBrands: { name: string; logo?: string; aliases?: string[] }[] = (site as any).featuredBrands ?? [];
const featuredNames = new Set(featuredBrands.flatMap((b) => [b.name, ...(b.aliases ?? [])].map((n) => n.toLowerCase())));
const otherBrands = site.brands.filter((b: string) => !featuredNames.has(b.toLowerCase()));

const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.postalCode} ${site.address.city}`);
const DAY_LONG: Record<string, string> = { 'Mån–tors': 'Måndag–torsdag', Fredag: 'Fredag', 'Lör–sön': 'Lördag–söndag' };
const [weekdays, friday] = site.hours;
---

<Base
  title="Arbetskläder & profilkläder till företag | Proarb Eskilstuna"
  description={site.description}
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="duo" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values=".33 .33 .33 0 0  .33 .33 .33 0 0  .33 .33 .33 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.059 0.937" />
        <feFuncG type="table" tableValues="0.173 0.914" />
        <feFuncB type="table" tableValues="0.2 0.867" />
      </feComponentTransfer>
    </filter>
  </svg>

  <!-- Hero -->
  <section class="hero">
    <img
      class="hero__img"
      src="/images/kategorier/arbetsjackor.webp"
      alt="Arbetsjackor från Proarbs sortiment"
      width="1680" height="720"
      fetchpriority="high"
    />
    <div class="hero__type">
      <div class="container hero__in">
        <h1>Kläder för folk som <em>jobbar.</em></h1>
        <div class="hero__note">
          <p>
            Arbets- och profilkläder till hantverkare, åkerier, företag och föreningar
            i Mälardalen – och vi trycker loggan själva, i butiken på Rinmansgatan.
          </p>
          <p>Ring, maila eller kom förbi. Du pratar alltid med någon som kan plaggen.</p>
          <div class="hero__actions">
            <a class="btn btn--accent" href="#offert">Begär offert</a>
            <a class="link-arrow" href="/arbetsklader/">Se sortimentet</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skyltremsa -->
  <div class="strip">
    <div class="container strip__in">
      <a href="#butik">{site.address.street}<small>{site.address.postalCode} {site.address.city} · Butik &amp; showroom</small></a>
      <a href="#butik">{weekdays.days} {weekdays.time}<small>{friday.days} {friday.time} · helger stängt</small></a>
      <a href="/tryck-och-brodyr/">Eget tryck &amp; brodyr</a>
    </div>
  </div>

  <!-- 01 Arbetskläder -->
  <section class="section">
    <div class="container">
      <header class="shead">
        <div>
          <h2>Arbetskläder</h2>
          <p class="shead__lead">
            Rätt plagg och rätt klassning för jobbet – från byxan som klarar knästående
            hela dagen till varseljackan som håller vintern ut.
          </p>
        </div>
      </header>

      <div class="cats">
        {workFeature.map((c) => (
          <a class={`cat ${c.slot}`} href={`/${c.url}/`}>
            <figure><img src={c.image} alt="" loading="lazy" /></figure>
            <div class="cat__cap">
              <h3>{c.title}</h3>
            </div>
            {c.text && <p>{c.text}</p>}
          </a>
        ))}
      </div>

      <nav class="index" aria-label="Fler arbetskläder">
        {workIndex.map((c, i) => (
          <a href={`/${c.url}/`}>
            <strong>{c.cat.name}</strong>
            <i>{c.note}</i>
            <svg width="22" height="22" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" /></svg>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 02 Profilprodukter -->
  <section class="section section--sunk">
    <div class="container">
      <header class="shead">
        <div>
          <h2>Profilprodukter</h2>
          <p class="shead__lead">
            Tröjor, pikéer och give aways med er logotyp – till säljkåren, mässan,
            laget eller julbordet. Tryck och brodyr gör vi själva.
          </p>
        </div>
      </header>

      <div class="pcats">
        {profileFeature.map((c) => (
          <a class={`cat ${c.slot}`} href={`/${c.url}/`}>
            <figure><img src={c.image} alt="" loading="lazy" style={c.pos ? `object-position:${c.pos}` : undefined} /></figure>
            <div class="cat__cap">
              <h3>{c.title}</h3>
            </div>
          </a>
        ))}
      </div>

      <nav class="index" aria-label="Fler profilprodukter">
        {profileIndex.map((c, i) => (
          <a href={`/${c.url}/`}>
            <strong>{c.cat.name}</strong>
            <i>{c.note}</i>
            <svg width="22" height="22" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" /></svg>
          </a>
        ))}
        <a href="/tryck-och-brodyr/">
          <strong>Tryck &amp; brodyr</strong>
          <i>Så funkar det, filformat och priser</i>
          <svg width="22" height="22" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" /></svg>
        </a>
      </nav>
    </div>
  </section>

  <!-- Utvalda produkter -->
  <section class="section picks">
    <div class="container">
      <header class="shead">
        <div>
          <h2>Utvalda produkter</h2>
          <p class="shead__lead">
            Ett axplock av det vi säljer mest av. Alla plagg går att få med ert tryck eller
            er brodyr – be om pris så återkommer vi inom en arbetsdag.
          </p>
        </div>
      </header>

      {featuredGroups.map((g: any) => (
        <div class="pgroup">
          <div class="pgroup__head">
            <h3>{g.title}</h3>
            <a class="link-arrow" href={g.href}>Se alla <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg></a>
          </div>
          <ul class="pgroup__list">
            {g.items.map((it: any) => (
              <li>
                <a class="fp" href={it.href}>
                  <div class={`fp__media${it.image || it.product?.image ? '' : ' fp__media--empty'}`}>
                    {it.image ? (
                      <img src={it.image} alt={it.name} loading="lazy" />
                    ) : it.product?.image ? (
                      <ProductImage file={it.product.file} src={it.product.image} alt={it.name} sizes="(max-width: 700px) 70vw, 300px" class="fp__img" />
                    ) : (
                      <span class="fp__ph" aria-hidden="true">{it.brand}</span>
                    )}
                    {it.imageHover && <img class={`fp__hover${it.hoverCover ? ' fp__hover--cover' : ''}`} src={it.imageHover} alt="" loading="lazy" aria-hidden="true" />}
                    {staging && !it.image && !it.product?.image && <span class="fp__tag">Bild saknas</span>}
                  </div>
                  <div class="fp__body">
                    <span class="fp__brand">{it.brand}</span>
                    <h4>{it.name}</h4>
                    <span class="fp__detail">{it.detail}</span>
                    {it.text && <p class="fp__text">{it.text}</p>}
                    <span class="fp__cta">Begär offert <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Så går det till -->
  <section class="section section--sunk">
    <div class="container">
      <header class="shead">
        <div><h2>Så går det till</h2></div>
      </header>
      <ol class="steps">
        {site.steps.map((s: any) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 Personlig service -->
  <section class="section people">
    <div class="container">
      <header class="shead">
        <div><h2>Personlig service</h2></div>
      </header>
      <div class="people__in">
        {about.photo ? (
          <img class="people__photo" src={about.photo} alt={`Personalen i butiken på ${site.address.street}`} loading="lazy" />
        ) : staging ? (
          <div class="ph">
            <span class="ph__tag">Platshållare – syns bara på testsajten</span>
            Foto på er i butiken.
          </div>
        ) : null}
        <div class="people__copy">
          {reviews.length ? (
            <div class="rv" data-reviews aria-roledescription="karusell" aria-label="Kundomdömen">
              <div class="rv__stage">
                {reviews.map((r, i) => (
                  <figure class={`rv__item${i === 0 ? ' is-active' : ''}`} aria-hidden={i === 0 ? undefined : 'true'} data-i={i}>
                    <blockquote class={`pquote${r.text.length > 170 ? ' pquote--long' : r.text.length > 90 ? ' pquote--mid' : ''}`}>{r.text}</blockquote>
                    <figcaption class="pquote__by">— {r.name}{r.company && `, ${r.company}`}{r.label && <span class="pquote__tag">{r.label}</span>}</figcaption>
                  </figure>
                ))}
              </div>
              {reviews.length > 1 && (
                <div class="rv__nav">
                  <button class="rv__btn" type="button" data-rv-prev aria-label="Föregående omdöme">
                    <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M12 7H2M6 3 2 7l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
                  </button>
                  <div class="rv__dots">
                    {reviews.map((r, i) => (
                      <button type="button" class={`rv__dot${i === 0 ? ' is-active' : ''}`} data-rv-dot={i} aria-label={`Visa omdöme ${i + 1} av ${reviews.length}`}></button>
                    ))}
                  </div>
                  <button class="rv__btn" type="button" data-rv-next aria-label="Nästa omdöme">
                    <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
                  </button>
                </div>
              )}
            </div>
          ) : (
            <p class="pquote">
              Ingen kundtjänstkö. Ni når oss direkt på telefon, får svar samma dag
              och pratar med samma person från förslag till leverans.
            </p>
          )}
          <div class="facts">
            {about.founded ? (
              <div><b>{about.founded}</b><span>Grundat i Eskilstuna</span></div>
            ) : staging ? (
              <div><b>[ÅR]</b><span>Grundat i Eskilstuna <span class="ph__tag">Fyll i</span></span></div>
            ) : (
              <div><b>1 dag</b><span>Svar på offert</span></div>
            )}
            <div><b>35+</b><span>Varumärken</span></div>
            <div><b>0</b><span>Mellanhänder på tryck &amp; brodyr</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Märkena -->
  <section class="section brands">
    <div class="container">
      <header class="shead">
        <div>
          <h2>Märkena</h2>
          <p class="shead__lead">Leverantörer vi jobbar med. Saknas ert favoritmärke? Fråga – vi har fler.</p>
        </div>
      </header>
      <ul class="blogos" aria-label="Våra största varumärken">
        {featuredBrands.map((b) => (
          <li class="blogos__item">
            {b.logo ? <img src={b.logo} alt={b.name} loading="lazy" /> : <span class="blogos__word">{b.name}</span>}
          </li>
        ))}
      </ul>
      <ul class="brands__list" aria-label="Fler varumärken vi jobbar med">
        {otherBrands.map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  <!-- 06 Kom förbi -->
  <section class="section section--sunk visit" id="butik">
    <div class="container">
      <header class="shead">
        <div><h2>Kom förbi</h2></div>
      </header>
      <div class="visit__in">
        <div class="visit__copy">
          <h3>{site.address.street},<br />{site.address.city}</h3>
          <p>
            Personlig rådgivning och showroom mitt i Eskilstuna. Prova storlekar, känn på
            tygerna och se hur loggan blir innan något trycks. Kaffet står på.
          </p>
          <table class="hours">
            <caption class="visually-hidden">Öppettider</caption>
            <tbody>
              {site.hours.map((h: { days: string; time: string }) => (
                <tr><th scope="row">{DAY_LONG[h.days] ?? h.days}</th><td>{h.time}</td></tr>
              ))}
            </tbody>
          </table>
          <a class="bigtel" href={site.phoneHref}>{site.phone}</a>
          <a class="visit__mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="visit__map">
          <iframe
            title={`Karta till ${site.legalName}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Offert -->
  <section class="section" id="offert">
    <div class="container">
      <header class="shead">
        <div><h2>Begär offert</h2></div>
      </header>
      <div class="quote">
        <div class="quote__copy">
          <p class="lead">
            Berätta om er verksamhet – antal personer, yrken och vad som ska tryckas – så
            återkommer vi med ett förslag inom en arbetsdag.
          </p>
          <ul class="ticks">
            {site.usp.map((u: any) => (
              <li><strong>{u.title}</strong><span>{u.text}</span></li>
            ))}
          </ul>
          <p class="quote__alt">
            Vill du hellre prata? Ring <a href={site.phoneHref}>{site.phone}</a> eller maila
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </div>
        <QuoteForm heading="Få ett förslag" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero { position: relative; background: var(--petrol-deep); }
  .hero__img {
    width: 100%; height: min(66vh, 640px); min-height: 440px;
    object-fit: cover; object-position: 30% 40%;
  }
  .hero__type {
    position: absolute; inset: auto 0 0 0;
    background: linear-gradient(180deg, transparent 0%, rgba(15, 44, 51, .55) 100%);
  }
  .hero__in { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .hero h1 {
    font-size: clamp(3.6rem, 1rem + 8.4vw, 9.4rem); line-height: .84; letter-spacing: -.01em;
    color: var(--paper); padding-bottom: 2.4rem; max-width: 12ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, .25);
  }
  .hero h1 em { font-style: normal; color: var(--amber); }
  .hero__note {
    background: var(--paper); color: var(--ink); width: 23rem; flex: none;
    padding: 1.6rem 1.6rem 1.8rem; font-size: 1rem;
    border: var(--rule); border-bottom: 0;
  }
  .hero__note p + p { margin-top: .9rem; }
  .hero__actions { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 1.4rem; }

  /* Skyltremsa ------------------------------------------------------------ */
  .strip { background: var(--amber); border-block: var(--rule); }
  .strip__in { display: grid; grid-template-columns: repeat(3, 1fr); }
  .strip a {
    padding: 1rem 0 1.05rem; text-decoration: none;
    font-family: var(--font-display); font-weight: 700; font-size: 1.35rem;
    text-transform: uppercase; letter-spacing: .02em; line-height: 1.1;
  }
  .strip a + a { border-left: var(--rule); padding-left: 1.4rem; }
  .strip a:hover small { text-decoration: underline; }
  .strip small {
    display: block; margin-top: .2rem; font-family: var(--font-body); text-transform: none;
    font-weight: 500; font-size: .88rem; letter-spacing: 0;
  }

  /* Kategorier: redaktionellt raster + duoton ------------------------------ */
  .cats { display: grid; grid-template-columns: repeat(12, 1fr); gap: 2.6rem 1.6rem; }
  .cat { text-decoration: none; display: block; }
  .cat figure { background: var(--petrol); overflow: hidden; }
  .cat img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .5s cubic-bezier(.2, .8, .3, 1);
  }
  .cat:hover img, .cat:focus-visible img { transform: scale(1.03); }
  /* Touch: duoton som får färg när bilden passerar mitten av skärmen (se script).
     Dator: alltid full färg. */
  @media (hover: none) {
    .cat img { filter: url(#duo); transition: filter .6s ease, transform .8s cubic-bezier(.2, .8, .3, 1); }
    .cat.is-lit img { filter: none; transform: scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat.is-lit img, .cat:hover img, .cat:focus-visible img { transform: none; }
  }
  .cat__cap {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    border-bottom: var(--rule); padding: .85rem 0 .7rem;
  }
  .cat h3 { font-size: clamp(1.7rem, 1.4rem + 1vw, 2.2rem); font-weight: 800; text-transform: uppercase; line-height: 1; }
  .cat p { font-size: .95rem; color: var(--ink-2); margin-top: .7rem; max-width: 38ch; }
  .c1 { grid-column: 1 / 8; } .c1 figure { aspect-ratio: 4 / 3.1; }
  .c2 { grid-column: 8 / 13; margin-top: 7rem; } .c2 figure { aspect-ratio: 4 / 5; }
  .c3 { grid-column: 1 / 5; } .c3 figure { aspect-ratio: 1; }
  .c4 { grid-column: 5 / 13; } .c4 figure { aspect-ratio: 16 / 9; }

  .pcats { display: grid; grid-template-columns: repeat(12, 1fr); gap: 2.6rem 1.6rem; }
  .p1 { grid-column: 1 / 6; grid-row: span 2; } .p1 figure { aspect-ratio: 4 / 5; }
  .p2 { grid-column: 6 / 13; } .p2 figure { aspect-ratio: 21 / 9; }
  .p3 { grid-column: 6 / 13; } .p3 figure { aspect-ratio: 21 / 9; }

  /* Indexrader */
  .index { margin-top: 4rem; border-top: var(--rule); }
  .index a {
    display: grid; grid-template-columns: 1fr auto 2rem; align-items: center; gap: 1rem;
    padding: 1.05rem 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    text-decoration: none; transition: background-color .15s, padding .2s;
  }
  .index a:hover { background: var(--amber); padding-inline: 1rem; }
  .index strong { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem); line-height: 1; }
  .index i { font-style: normal; font-size: .9rem; color: var(--ink-2); }
  .index svg { justify-self: end; }

  /* Utvalda produkter */
  .pgroup + .pgroup { margin-top: clamp(2.8rem, 2rem + 2.5vw, 4.2rem); }
  .pgroup__head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    border-bottom: var(--rule); padding-bottom: .7rem; margin-bottom: 1.2rem;
  }
  .pgroup__head h3 { font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.3rem); font-weight: 800; text-transform: uppercase; line-height: 1; }
  .pgroup__head .link-arrow { font-size: .92rem; white-space: nowrap; }
