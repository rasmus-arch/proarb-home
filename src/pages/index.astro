<script>
  // På touchskärmar finns ingen hover – tänd kategoribilderna när de scrollas
  // in i mittenbandet av skärmen, och släck dem igen när de lämnar det.
  if (window.matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-lit', e.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px' }
    );
    document.querySelectorAll('.cat').forEach((el) => io.observe(el));
  }
</script>

<script>
  // Kundomdömen: roterar automatiskt, pausar vid hovring/fokus och när man själv bläddrar
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.rv__item')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-rv-dot]')];
    if (items.length < 2) return;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      items.forEach((el, k) => {
        el.classList.toggle('is-active', k === i);
        if (k === i) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => { if (!reduce && !timer) timer = window.setInterval(() => show(i + 1), 7000); };
    root.querySelector('[data-rv-prev]')?.addEventListener('click', () => { stop(); show(i - 1); });
    root.querySelector('[data-rv-next]')?.addEventListener('click', () => { stop(); show(i + 1); });
    dots.forEach((d, k) => d.addEventListener('click', () => { stop(); show(k); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    start();
  });
</script>
