---
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductImage from '../components/ProductImage.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site, productsIn, categoryByUrl } from '../lib/content';

const UPLOADS = 'https://proarb.se/wp-content/uploads/2026/04/';

const showcase = [
  { size: 'full', url: 'arbetsklader', image: '/images/kategorier/arbetsklader.jpg' },
  { size: 'half', url: 'varselklader', image: '/images/kategorier/varselklader.webp' },
  { size: 'half', url: 'arbetsbyxor', image: '/images/kategorier/arbetsbyxor.webp' },
  { size: 'full', url: 'arbetsjackor', image: '/images/kategorier/arbetsjackor.webp' },
  { size: 'half', url: 'arbetshandskar', image: UPLOADS + 'ei_7776-12-768x512.webp' },
  { size: 'half', url: 'arbetsskor', image: UPLOADS + 'dsc04899-768x512.jpg' },
  { size: 'full', url: 'ovriga-profilklader', image: UPLOADS + 'profilklader-1536x540.webp' },
  { size: 'half', url: 'profiltrojor', image: UPLOADS + '1110228_HeavyTshirt_2.jpg' },
  { size: 'half', url: 'give-aways', image: UPLOADS + 'Skarmbild-2026-04-01-103244.png' }
].map((item) => ({ ...item, cat: categoryByUrl(item.url)! }));

const featured = [
  ...productsIn('arbetsjackor').slice(0, 2),
  ...productsIn('arbetsbyxor').slice(0, 2),
  ...productsIn('varselklader').slice(0, 2),
  ...productsIn('arbetsskor').slice(0, 1),
  ...productsIn('arbetshandskar').slice(0, 1)
].filter((p, i, a) => a.findIndex((x) => x.slug === p.slug) === i).slice(0, 8);

const heroTiles = [
  productsIn('varselklader')[0],
  productsIn('arbetsjackor')[0],
  productsIn('arbetsskor')[0],
  productsIn('profiltrojor')[0]
].filter(Boolean);

const profileTeaser = productsIn('profilprodukter').slice(0, 4);
---

<Base
  title="Arbetskläder & profilkläder till företag | Proarb Eskilstuna"
  description={site.description}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__copy">
        <p class="eyebrow">Eskilstuna sedan starten</p>
        <h1>Arbetskläder som håller.<br />Profilkläder som syns.</h1>
        <p class="lead">
          Allt för byggföretag, tjänsteföretag och föreningar – rätt plagg, rätt klassning
          och er logotyp på rätt ställe. Personlig service från första samtalet till leveransen.
        </p>
        <div class="cluster hero__cta">
          <a class="btn btn--ghost" href="/arbetsklader/">Se sortimentet</a>
          <a class="btn" href="/kontakt/">Begär offert</a>
        </div>
        <dl class="hero__facts">
          <div><dt>Svar</dt><dd>inom en arbetsdag</dd></div>
          <div><dt>Varumärken</dt><dd>{site.brands.length}+ i sortimentet</dd></div>
          <div><dt>Personlig service</dt><dd>en kontaktperson, inte en kö</dd></div>
        </dl>
      </div>

      <div class="hero__tiles" aria-hidden="true">
        {heroTiles.map((p, i) => (
          <div class={`tile tile--${i}`}>
            <ProductImage file={p.file} src={p.image} alt="" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} sizes="(max-width: 900px) 40vw, 260px" class="tile__img" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kategorier -->
  <section class="section cshow">
    <div class="container">
      <header class="sechead">
        <div>
          <p class="eyebrow">Sortimentet</p>
          <h2>Hitta rätt kategori direkt</h2>
        </div>
      </header>
      <div class="cshow__grid">
        {showcase.map((item) => (
          <a class={`cband cband--${item.size}`} href={`/${item.url}/`}>
            <img class="cband__img" src={item.image} alt="" loading="lazy" />
            <span class="cband__scrim" aria-hidden="true"></span>
            <div class="cband__copy">
              <h3>{item.cat.h1}</h3>
              <p>{item.cat.lead}</p>
              <span class="btn btn--sm cband__btn">
                Se sortimentet
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Utvalda produkter -->
  <section class="section section--sunk">
    <div class="container">
      <header class="sechead">
        <div>
          <p class="eyebrow">Ett urval</p>
          <h2>Plagg vi säljer mest av</h2>
          <p class="lead">Sajten visar en del av sortimentet. Hittar ni inte rätt plagg tar vi fram det ur leverantörernas fulla kataloger.</p>
        </div>
      </header>
      <ProductGrid products={featured} eagerCount={0} />
    </div>
  </section>

  <!-- Så funkar det -->
  <section class="section">
    <div class="container">
      <header class="sechead">
        <div>
          <p class="eyebrow">Så går det till</p>
          <h2>Från samtal till levererad kollektion</h2>
        </div>
      </header>
      <ol class="steps">
        {site.steps.map((s: any, i: number) => (
          <li class="step">
            <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Profilprodukter -->
  <section class="promo">
    <div class="container promo__in">
      <div class="promo__copy">
        <p class="eyebrow">Profilprodukter</p>
        <h2>Er billigaste reklampelare</h2>
        <p>
          Profiltröjor syns överallt, hela tiden. Vi brandar pikéer, jackor och skjortor
          till säljkåren – och fixar give aways till mässan, laget eller julbordet.
        </p>
        <div class="cluster">
          <a class="btn btn--accent" href="/profilprodukter/">Se profilprodukter</a>
          <a class="btn btn--ghost" href="/give-aways/">Give aways</a>
        </div>
      </div>
      <div class="promo__cards">
        {profileTeaser.map((p) => (
          <a class="promo__card" href={`/produkt/${p.slug}/`}>
            <ProductImage file={p.file} src={p.image} alt={p.name} sizes="160px" class="promo__img" />
            <span>{p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Varumärken -->
  <section class="section section--sunk brands">
    <div class="container">
      <header class="sechead">
        <div>
          <p class="eyebrow">Leverantörer</p>
          <h2>Varumärken vi jobbar med</h2>
        </div>
      </header>
      <ul class="brands__grid">
        {site.brands.map((b: string) => <li class="brands__tile">{b}</li>)}
      </ul>
      <p class="muted brands__note">…och fler därtill. Har ni ett favoritmärke? Fråga oss.</p>
    </div>
  </section>

  <!-- Offert -->
  <section class="section" id="offert">
    <div class="container quote">
      <div class="quote__copy">
        <p class="eyebrow">Rådgivning</p>
        <h2>Få rådgivning för ditt företag</h2>
        <p class="lead">
          Att välja rätt utrustning för teamet kan vara en utmaning. Berätta om er verksamhet
          så analyserar vi behovet – slitstyrka, funktion och visuell profilering – och
          återkommer med ett förslag.
        </p>
        <ul class="ticks">
          {site.usp.map((u: any) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><strong>{u.title}.</strong> {u.text}</span>
            </li>
          ))}
        </ul>
        <p class="quote__alt">
          Hellre prata? Ring <a href={site.phoneHref}>{site.phone}</a> eller maila
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <QuoteForm />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem); overflow: clip; }
  .hero__in { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  @media (max-width: 900px) { .hero__in { grid-template-columns: 1fr; } }
  .hero__copy h1 { margin: .8rem 0 1.1rem; }
  .hero__cta { margin-top: 1.9rem; }
  .hero__facts {
    display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2.6rem;
    padding-top: 1.6rem; border-top: 1px solid var(--line);
  }
  .hero__facts dt { font-family: var(--font-display); font-weight: 650; font-size: .95rem; }
  .hero__facts dd { margin: .1rem 0 0; font-size: .88rem; color: var(--ink-3); }

  .hero__tiles {
    position: relative; display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(.6rem, .3rem + 1vw, 1rem);
  }
  .tile {
    background: var(--bg-sunk); border: 1px solid var(--line); border-radius: var(--r-lg);
    aspect-ratio: 1; display: grid; place-items: center; overflow: hidden;
  }
  .tile :global(.tile__img) { width: 100%; height: 100%; object-fit: contain; padding: 12%; mix-blend-mode: multiply; }
  .tile--0 { border-radius: var(--r-lg) var(--r-lg) var(--r-lg) 3.5rem; }
  .tile--1 { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .tile--2 { margin-top: calc(-1 * clamp(1rem, 3vw, 2.5rem)); }
  .tile--3 { border-radius: var(--r-lg) 3.5rem var(--r-lg) var(--r-lg); }
  /* Sektionsrubriker */
  .sechead {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem;
    margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.6rem); flex-wrap: wrap;
  }
  .sechead h2 { margin-top: .7rem; }
  .sechead .lead { margin-top: .9rem; font-size: var(--step-0); }

  /* Kategorimonter */
  .cshow__grid { display: grid; gap: clamp(.7rem, .4rem + 1vw, 1.1rem); grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 720px) { .cshow__grid { grid-template-columns: 1fr; } }
  .cband {
    position: relative; display: block; text-decoration: none; color: #fff;
    border-radius: var(--r-lg); overflow: hidden; isolation: isolate;
    transition: transform .2s cubic-bezier(.2,.8,.3,1), box-shadow .2s;
  }
  .cband:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .cband:hover .cband__img { transform: scale(1.045); }
  .cband--full { grid-column: 1 / -1; aspect-ratio: 21 / 9; }
  .cband--half { aspect-ratio: 4 / 3; }
  @media (max-width: 700px) { .cband--full { aspect-ratio: 4 / 3; } }
  .cband__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    z-index: -2; transition: transform .4s cubic-bezier(.2,.8,.3,1);
  }
  .cband__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(10,20,23,.15) 0%, rgba(10,20,23,.42) 55%, rgba(10,20,23,.72) 100%);
  }
  .cband__copy {
    position: relative; height: 100%; display: flex; flex-direction: column;
    align-items: center; justify-content: flex-end; text-align: center; gap: .5rem;
    padding: clamp(1.2rem, 1rem + 1.5vw, 2.25rem); text-wrap: balance;
  }
  .cband--full .cband__copy { justify-content: center; }
  .cband__copy h3 { margin: 0; color: #fff; font-size: var(--step-2); }
  .cband--full .cband__copy h3 { font-size: var(--step-3); }
  .cband__copy p { margin: 0; color: rgba(255,255,255,.88); max-width: 34ch; font-size: .92rem; }
  .cband--full .cband__copy p { font-size: 1rem; max-width: 46ch; }
  .cband__btn { margin-top: .3rem; --btn-bg: #fff; --btn-fg: var(--ink); gap: .45rem; }
  .cband__btn:hover { --btn-bg: #fff; }

  /* Steg */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1rem, .6rem + 1.5vw, 2rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); counter-reset: s; }
  .step { border-top: 2px solid var(--ink); padding-top: 1rem; }
  .step__n { font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .1em; color: var(--accent-ink); }
  .step h3 { font-size: var(--step-1); margin: .5rem 0 .45rem; }
  .step p { color: var(--ink-2); font-size: .95rem; }

  /* Promo */
  .promo { background: var(--accent-soft); color: var(--ink-2); padding-block: var(--section); }
  .promo__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: center; }
  @media (max-width: 860px) { .promo__in { grid-template-columns: 1fr; } }
  .promo h2 { color: var(--ink); margin: .7rem 0 1rem; }
  .promo p { max-width: 46ch; margin-bottom: 1.8rem; }
  .promo__cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; }
  .promo__card {
    background: var(--bg); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: .8rem; text-decoration: none; color: inherit;
    display: grid; gap: .6rem; transition: border-color .18s, transform .18s;
  }
  .promo__card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .promo__card :global(.promo__img) { width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--bg); border-radius: var(--r); padding: 8%; }
  .promo__card span { font-size: .84rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Varumärken */
  .brands__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: .8rem;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
  }
  .brands__tile {
    display: grid; place-items: center; text-align: center;
    min-height: 4.5rem; padding: .6rem .8rem;
    font-family: var(--font-display); font-weight: 620; font-size: .92rem;
    letter-spacing: -.01em; color: var(--ink-2);
    border: 1px solid var(--line); background: var(--bg); border-radius: var(--r);
    transition: border-color .15s, color .15s;
  }
  .brands__tile:hover { border-color: var(--line-strong); color: var(--ink); }
  .brands__note { margin-top: 1.4rem; font-size: .9rem; }

  /* Offert */
  .quote { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .quote { grid-template-columns: 1fr; } }
  .quote h2 { margin: .7rem 0 1rem; }
  .ticks { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: .8rem; }
  .ticks li { display: flex; gap: .7rem; align-items: flex-start; font-size: .95rem; color: var(--ink-2); }
  .ticks svg { color: var(--accent-ink); flex: none; margin-top: .15rem; }
  .quote__alt { margin-top: 1.8rem; font-size: .95rem; color: var(--ink-3); }
  .quote__alt a { font-weight: 550; color: var(--ink); margin-inline: .2rem; }
</style>
