# Proarb – statisk sajt på cPanel/Apache
# Motsvarar public/_redirects (som bara läses av Netlify/Cloudflare Pages)

RewriteEngine On

# Tvinga https + www -> utan www (justera om ni vill ha www kvar)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Gamla WordPress/WooCommerce-URL:er -> nya
RewriteRule ^product/(.*)$ /produkt/$1 [R=301,L]
RewriteRule ^product-category/arbetsklader/?(.*)$ /arbetsklader/ [R=301,L]
RewriteRule ^product-category/profilprodukter/?(.*)$ /profilprodukter/ [R=301,L]
RewriteRule ^shop/?$ /arbetsklader/ [R=301,L]
RewriteRule ^cart/?$ /kontakt/ [R=301,L]
RewriteRule ^checkout/?$ /kontakt/ [R=301,L]
RewriteRule ^my-account/?$ /kontakt/ [R=301,L]
RewriteRule ^rea-2/?$ /arbetsklader/ [R=301,L]
RewriteRule ^ny-start/?$ / [R=301,L]
RewriteRule ^sample-page/?$ / [R=301,L]
RewriteRule ^privacy-policy/?$ /integritetspolicy/ [R=301,L]
RewriteRule ^wp-admin/?(.*)$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]

# Astro bygger med trailingSlash "always" och format "directory",
# dvs varje sida ligger som en egen mapp med index.html i.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Komprimering
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache – hashade tillgångar (bilder/CSS/JS under /_astro/) kan cachas länge,
# HTML-sidor cachas kort så uppdateringar syns snabbt.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
