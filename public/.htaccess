# Proarb – statisk sajt på cPanel/Apache
# Motsvarar public/_redirects (som bara läses av Netlify/Cloudflare Pages)

RewriteEngine On

# Tvinga https + www -> utan www (justera om ni vill ha www kvar)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Gamla WordPress/WooCommerce-URL:er -> nya
# Produkter: en adress per storlek/färg på gamla sajten -> slås upp i gammal-produkt.php
RewriteRule ^gamla-produkter/ - [F,L]
RewriteRule ^product/([^/]+)/?$ /gammal-produkt.php?s=$1 [L]
RewriteRule ^product/ /arbetsklader/ [R=301,L]

# Kategorier
RewriteRule ^product-category/arbetsklader/arbetbyxor/? /arbetsbyxor/ [R=301,L]
RewriteRule ^product-category/arbetsklader/arbetshandskar/? /arbetshandskar/ [R=301,L]
RewriteRule ^product-category/arbetsklader/arbetsjackor/? /arbetsjackor/ [R=301,L]
RewriteRule ^product-category/arbetsklader/arbetsshorts/? /arbetsshorts-piratbyxor/ [R=301,L]
RewriteRule ^product-category/arbetsklader/arbetsskor/? /arbetsskor/ [R=301,L]
RewriteRule ^product-category/arbetsklader/arbetstrojor/? /arbetstrojor/ [R=301,L]
RewriteRule ^product-category/arbetsklader/varselklader/? /varselklader/ [R=301,L]
RewriteRule ^product-category/profilprodukter/give-aways/? /give-aways/ [R=301,L]
RewriteRule ^product-category/profilprodukter/profilklader/profiljackor/? /profiljackor/ [R=301,L]
RewriteRule ^product-category/profilprodukter/profilklader/profilskjortor/? /profilskjortor/ [R=301,L]
RewriteRule ^product-category/profilprodukter/profilklader/profiltrojor/? /profiltrojor/ [R=301,L]
RewriteRule ^product-category/profilprodukter/profilklader/? /ovriga-profilklader/ [R=301,L]
RewriteRule ^product-category/profilprodukter/? /profilprodukter/ [R=301,L]
RewriteRule ^product-category/ /arbetsklader/ [R=301,L]

# Varumärkessidor (gamla /brand/<namn>/ -> nya /varumarke/<namn>/)
RewriteRule ^brand/james-harvest/? /varumarke/harvest-sportswear/ [R=301,L]
RewriteRule ^brand/solstickan/? /varumarke/solstickan-design/ [R=301,L]
RewriteRule ^brand/(atg|blaklader|clique|craft|cutter-buck|dj|graphix|harvest-frost|helly-hansen|id-identity|jalas|james-nicholson|jobman|kosta-linnewaveri|lord-nelson|monitor|nightingale|orrefors|printer|projob|queen-anne|skechers|teejays|tegera|toppoint|under-armour)/? /varumarke/$1/ [R=301,L]
RewriteRule ^brand/ /arbetsklader/ [R=301,L]

# Övriga sidor
RewriteRule ^shop/?$ /arbetsklader/ [R=301,L]
RewriteRule ^(cart|checkout|my-account)(/.*)?$ /kontakt/ [R=301,L]
RewriteRule ^rea-2/?$ /arbetsklader/ [R=301,L]
RewriteRule ^flamsakra-produkter/?$ /arbetsklader/ [R=301,L]
RewriteRule ^restaurang/?$ /ovriga-profilklader/ [R=301,L]
RewriteRule ^(utemobler|vm-2026)/?$ /profilprodukter/ [R=301,L]
RewriteRule ^privacy-policy/?$ /integritetspolicy/ [R=301,L]
RewriteRule ^(ny-start|sample-page|hello-world)/?$ / [R=301,L]
RewriteRule ^(author|category|product-tag|tag)/ / [R=301,L]
RewriteRule ^wp-admin/?(.*)$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|sitemap)\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^[a-z_]+-sitemap[0-9]*\.xml$ /sitemap-index.xml [R=301,L]

# Astro bygger med trailingSlash "always" och format "directory",
# dvs varje sida ligger som en egen mapp med index.html i.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Komprimering
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache – hashade tillgångar (bilder/CSS/JS under /_astro/) kan cachas länge,
# HTML-sidor cachas kort så uppdateringar syns snabbt.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
